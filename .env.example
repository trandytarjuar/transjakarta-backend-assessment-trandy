# Copy this file to .env and replace credentials for your environment.
API_PORT=8080
MQTT_PORT=1883
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://fleet:change-me@postgres:5432/fleet?sslmode=disable

MQTT_BROKER=tcp://mosquitto:1883
MQTT_TOPIC=/fleet/vehicle/+/location
MQTT_USERNAME=fleet
MQTT_PASSWORD=change-me

RABBITMQ_USER=fleet
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://fleet:change-me@rabbitmq:5672/

GEOFENCE_LAT=-6.21462
GEOFENCE_LON=106.84513
GEOFENCE_RADIUS_METERS=50

VEHICLE_ID=TJ-001
