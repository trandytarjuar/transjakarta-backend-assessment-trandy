# Local Docker Compose configuration. Do not commit production secrets.
API_PORT=18080
MQTT_PORT=1883
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
DATABASE_URL=postgres://fleet:fleet@postgres:5432/fleet?sslmode=disable

MQTT_BROKER=tcp://mosquitto:1883
MQTT_TOPIC=/fleet/vehicle/+/location
MQTT_USERNAME=fleet
MQTT_PASSWORD=fleet

RABBITMQ_USER=fleet
RABBITMQ_PASSWORD=fleet
RABBITMQ_URL=amqp://fleet:fleet@rabbitmq:5672/

GEOFENCE_LAT=-6.21462
GEOFENCE_LON=106.84513
GEOFENCE_RADIUS_METERS=50

VEHICLE_ID=TJ-001
